{
  "expo": {
    "name": "Samba",
    "slug": "sambaevents",
    "scheme": "samba",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sambaevents",
      "associatedDomains": [
        "applinks:samba-site-woad.vercel.app"
      ],
      "config": {
        "googleMapsApiKey": "AIzaSyBac1aYfzeeIRBuk5Ut_cPRsioAePxCkbk"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Samba uses the camera for profile photos, event images, and QR code scanning.",
        "NSPhotoLibraryUsageDescription": "Samba needs access to your photos to set a profile picture and upload event images.",
        "NSPhotoLibraryAddUsageDescription": "Samba can save images to your photo library.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to show events happening near you and help you discover local events.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBac1aYfzeeIRBuk5Ut_cPRsioAePxCkbk"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A1A"
      },
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "package": "com.sambaevents",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "samba-site-woad.vercel.app",
              "pathPrefix": "/events"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withFmtXcode26Fix",
      "expo-dev-client",
      [
        "expo-image-picker",
        {
          "photosPermission": "Samba needs access to your photos for profile pictures and event images.",
          "cameraPermission": "Samba uses the camera for profile photos and QR scanning."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Samba uses the camera for profile photos, event images, and QR code scanning."
        }
      ],
      "expo-location"
    ],
    "extra": {
      "eas": {
        "projectId": "edadc2f9-b25a-4f4f-856f-46afc658789e"
      }
    },
    "owner": "mousappsllc"
  }
}
