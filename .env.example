# Copy to .env for local development (expo start)
# After schema.sql + seed.sql in Supabase SQL Editor, demo logins use password: SambaDemo123!
# organizer1@samba.test | organizer2@samba.test | demo@samba.test

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-key
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Server-only — never put in the Expo app or commit to git
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

# ── TestFlight / EAS production builds ─────────────────────────────────────────
# .env is NOT uploaded to EAS automatically. Push the same EXPO_PUBLIC_* vars once:
#
#   eas env:push production --path .env --force
#   npm run eas:env:production
#
# Or set each variable in the Expo dashboard → Project → Environment variables → production.
# Then rebuild: eas build --platform ios --profile production
#
# Without this step, TestFlight builds use placeholder Supabase URLs and purchases fail.
